    "react-dom": "19.2.4",
    "react-icons": "^5.4.0",
    "remark-parse": "^11.0.0",
    "remark-table-of-content": "^0.5.2",
    "sharp": "0.32.6",
    "sonner": "^2.0.2",
    "tailwind-merge": "^2.5.5",
    "title-case": "^4.3.2",
    "tw-animate-css": "^1.2.0",
    "zod": "^3.25.0"
