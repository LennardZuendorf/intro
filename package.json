    "@vercel/speed-insights": "^1.1.0",
    "basehub": "^9.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "cross-env": "^7.0.3",
