    "check": "biome check --write . --no-errors-on-unmatched",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
